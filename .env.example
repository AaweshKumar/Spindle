# ==============================================================================
# DEV-ONLY demo credentials; never deploy as-is!
# Run scripts/gen-env.sh for real values.
# Dev admin login: admin / spindle-dev-only
#
# NOTES:
# - DATABASE_URL and REDIS_URL are built by compose, not set here.
# - If you build a URL by hand the scheme MUST be postgresql+psycopg2://
# - POSTGRES_PASSWORD must contain only letters, digits, hyphen or underscore (it is embedded unescaped in a URL).
# - ADMIN_PASSWORD_HASH must stay single-quoted.
# - CORS_ALLOW_ORIGINS is a JSON list in single quotes.
# ==============================================================================

POSTGRES_USER=spindle
POSTGRES_PASSWORD=spindle-dev-only
POSTGRES_DB=spindle
JWT_SECRET=spindle-dev-only-jwt-secret-key-at-least-40-chars-long
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$+mzqym/B5UxgckIzP0ll4Q$ItYIiineE1+laX9WKcl2GU69B7qK0grGPNVMPMi0i2c'
CORS_ALLOW_ORIGINS='[]'
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MOCK_ADMIN_PORT=9000

